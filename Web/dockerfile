# Build the React application using the committed npm lockfile.
FROM node:22-bookworm-slim AS frontend
WORKDIR /src/Web/ClientApp
COPY Web/ClientApp/package.json Web/ClientApp/package-lock.json ./
RUN npm ci
COPY Web/ClientApp/ ./
RUN npm run build

FROM mcr.microsoft.com/dotnet/sdk:11.0 AS build
WORKDIR /src
COPY . .
COPY --from=frontend /src/Web/ClientApp/dist ./Web/ClientApp/dist

# npm dependencies and output are supplied by the frontend stage.
RUN dotnet restore ./Web/Web.csproj -r linux-x64

RUN --mount=type=secret,id=ScaffoldConnectionString \
	ScaffoldConnectionString=$(cat /run/secrets/ScaffoldConnectionString) \
	dotnet publish ./Web/Web.csproj \
		-c Release -r linux-x64 --no-self-contained --no-restore \
		-p:BuildFrontend=false -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:11.0 AS publish
WORKDIR /app
USER app
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "Web.dll"]
