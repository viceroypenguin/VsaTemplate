#nullable enable
using Microsoft.Extensions.DependencyInjection;

namespace VsaTemplate.Web.Infrastructure.Startup;

internal static class ConfigureAllOptionsExtensions
{
	public static IServiceCollection ConfigureAllOptions(this IServiceCollection services)
	{
		{{~ for c in classes ~}}
		services.AddRequiredOptions<{{~ c.name ~}}>("{{~ c.path ~}}");
		{{~ end ~}}

		return services;
	}
}
